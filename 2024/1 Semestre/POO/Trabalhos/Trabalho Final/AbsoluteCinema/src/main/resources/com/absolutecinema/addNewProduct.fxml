      </TextField>
      <TextField fx:id="campoDescricao" layoutX="20.0" layoutY="274.0" prefHeight="44.0" prefWidth="260.0" promptText="Digite a descrição do produto" style="-fx-background-radius: 50; -fx-border-radius: 50;">
         <font>
            <Font name="Dubai Medium" size="14.0" />
