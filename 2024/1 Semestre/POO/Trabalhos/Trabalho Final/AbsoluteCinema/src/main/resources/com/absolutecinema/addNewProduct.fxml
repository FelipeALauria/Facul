      </TextField>
      <TextField fx:id="campoEstoque" layoutX="20.0" layoutY="338.0" prefHeight="44.0" prefWidth="260.0" promptText="Digite a quantidade em estoque" style="-fx-background-radius: 50; -fx-border-radius: 50;">
         <font>
            <Font name="Dubai Medium" size="14.0" />
