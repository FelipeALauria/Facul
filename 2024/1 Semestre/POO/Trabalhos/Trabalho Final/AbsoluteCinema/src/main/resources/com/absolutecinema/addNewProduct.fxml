            </ImageView>
            <Label layoutX="75.0" layoutY="11.0" prefHeight="54.0" prefWidth="171.0" text="     Novo Produto" textFill="#570128">
               <font>
                  <Font name="Dubai Regular" size="20.0" />
               </font>
            </Label>
         </children>
      </Pane>
      <TextField fx:id="campoNome" layoutX="20.0" layoutY="146.0" prefHeight="44.0" prefWidth="260.0" promptText="Digite o nome do produto" style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-background-color: #ffffff;">
         <font>
            <Font name="Dubai Medium" size="14.0" />
